# Ubao — compose configuration. Copy to .env and fill every CHANGE_ME.
# Generate secrets with: openssl rand -base64 32   (never commit .env)

# --- Public URL / TLS ---
PUBLIC_URL=https://ubao.example.org
PUBLIC_HOST=ubao.example.org
# Contact for Let's Encrypt; use "internal" in Caddy for a private CA (air-gapped)
ACME_EMAIL=admin@example.org

# --- Image (placeholder until the first release is published) ---
UBAO_IMAGE=ghcr.io/ubao/ubao-server
UBAO_VERSION=0.0.0-placeholder

# --- Database (PostgreSQL >= 15) ---
POSTGRES_USER=ubao
POSTGRES_DB=ubao
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://ubao:CHANGE_ME@postgres:5432/ubao

# --- Blob storage: s3 | disk (profile "minio" for bundled MinIO, profile "disk" otherwise) ---
STORAGE=s3
# disk mode
STORAGE_DISK_PATH=/data/blobs
# s3 mode (bundled MinIO by default; point to your own S3 if you prefer)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ubao
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# --- Authentication: magic_link | password | oidc ---
AUTH_MODE=magic_link
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# --- SMTP (required for magic links) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ubao@example.org
SMTP_TLS=starttls

# --- Keys (base64). Token signing: Ed25519 seed; encryption: 32-byte key (or KMS ref) ---
TOKEN_SIGNING_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
ENCRYPTION_KEYRING=env

# --- Optional: AI (BYO endpoint, off by default) ---
AI_ENABLED=false
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=

# --- Optional: OpenTelemetry (off by default) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ubao-server

# --- Policies ---
LOW_BANDWIDTH_DEFAULT=false
GUEST_ACCESS=false
LOG_LEVEL=info
