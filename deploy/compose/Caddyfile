{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
	encode zstd gzip
	# WebSocket sync (/sync) is proxied transparently; long-lived connections allowed.
	reverse_proxy ubao:8080 {
		health_uri /healthz
		health_interval 10s
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
